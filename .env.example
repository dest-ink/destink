# ─── Destink Environment Configuration ────────────────────────────────────────
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Required variables are marked with [REQUIRED].
# Optional variables enable additional features but the app runs without them.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string.
# If using the included docker-compose, the default below works as-is.
DATABASE_URL=postgresql://destink:destink@localhost:5432/destink

# ─── Security ─────────────────────────────────────────────────────────────────
# [REQUIRED] Used to encrypt stored credentials (platform API keys, cookies).
# Must be a 32-byte hex string. Generate one with:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# [REQUIRED] Used by NextAuth to sign and encrypt session tokens.
# Generate one with:
#   openssl rand -base64 33
AUTH_SECRET=

# ─── AI Providers ────────────────────────────────────────────────────────────
# [REQUIRED — at least one] Powers draft generation, topic ranking, and voice analysis.
#
# Anthropic API key — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenRouter API key — alternative provider that gives access to Claude and other models.
# Get one at https://openrouter.ai/keys
# Only needed if you don't have an Anthropic key, or want access to additional models.
OPENROUTER_API_KEY=

# ─── Research Sources ─────────────────────────────────────────────────────────
# These enable the research adapters that find content ideas for you.
# All are optional — the AI brainstorm adapter works without any of these.

# Exa — web search API for finding trending content and sources.
# Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Reddit — pulls trending discussions from subreddits you configure.
# Create an app at https://www.reddit.com/prefs/apps (select "script" type).
# The client ID is the string under the app name; the secret is labeled.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────────
# The public URL where the app is accessible. Used for OAuth callbacks and links.
# Change this when deploying to a real domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port the Next.js server listens on (default: 3000).
# PORT=3000
