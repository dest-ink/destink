# Copy this file to .env and populate values

# Database
DATABASE_URL=postgresql://orbitl:orbitl@localhost:5432/orbitl

# Encryption (32-byte hex key: openssl rand -hex 32)
ENCRYPTION_KEY=

# Auth (generate with: openssl rand -base64 33)
AUTH_SECRET=

# AI
ANTHROPIC_API_KEY=

# Research
EXA_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3021/api/auth/linkedin/callback

# App
NEXT_PUBLIC_APP_URL=http://localhost:3021
PORT=3021
